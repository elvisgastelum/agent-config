{
  "name": "agent-config",
  "version": "0.14.0",
  "private": true,
  "description": "Configure Claude Code, OpenCode, Codex and Pi from one TUI and a catalog of abilities, such as the model ladder, which routes reads and edits to the cheapest capable model (Haiku → Sonnet → Opus) so the main session's context stays small.",
  "homepage": "https://github.com/elvisgastelum/agent-config#readme",
  "bugs": {
    "url": "https://github.com/elvisgastelum/agent-config/issues"
  },
  "license": "MIT",
  "author": "Elvis Gastelum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elvisgastelum/agent-config.git"
  },
  "bin": {
    "agent-config": "./dist/cli.mjs",
    "agi": "./dist/cli.mjs",
    "model-ladder": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "bump": "node scripts/bump.ts",
    "agent-config": "node dist/cli.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^24.19.2",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
